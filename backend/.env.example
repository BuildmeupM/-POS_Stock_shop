# ============================================================
# POS Bookdee — Backend Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Runtime ---
NODE_ENV=development          # development | production
PORT=3001
HOST=0.0.0.0

# --- Database (MySQL) --- REQUIRED
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                  # REQUIRED — set a strong password
DB_NAME=pos_stock_shop

# --- Auth --- REQUIRED
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=                   # REQUIRED — must be >= 32 chars, random
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed origins (frontend URLs)
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=

# --- Uploads ---
# In production (Railway), point this at a mounted persistent Volume
UPLOAD_DIR=
